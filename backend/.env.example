# ThreatMind Environment Configuration

# Server Settings
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
DEBUG=True

# Authentication & Cryptographic Security
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ISSUER=threatmind-auth
JWT_AUDIENCE=threatmind-api
JWT_EXPIRATION_MINUTES=60

# LLM Configuration
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=your_gemini_api_key_here

# Neo4j Database Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

# Vector Search & Embedding Configuration
EMBEDDING_MODEL=all-MiniLM-L6-v2
